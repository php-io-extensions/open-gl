{
    "name": "php-io-extensions/open-gl",
    "type": "php-ext",
    "description": "PHP-Controllable OpenGL Rendering Extension",
    "license": "MIT",
    "version": "0.7.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "php-ext": {
        "extension-name": "opengl",
        "priority": 30,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families-exclude": [
            "windows"
        ],
        "configure-options": [
            {
                "name": "enable-opengl",
                "description": "Enable the opengl extension",
                "needs-value": false
            }
        ]
    }
}
